# ── ASR Dashboard Frontend — Environment Variables ─────────────────────────
# For local dev: copy to .env.local, leave VITE_API_URL blank (Vite proxy handles it)
# For Firebase deploy: set VITE_API_URL in your CI/CD or run:
#   export VITE_API_URL=https://your-backend.up.railway.app
#   npm run build

# URL of the deployed Railway backend (leave blank for local dev)
VITE_API_URL=
