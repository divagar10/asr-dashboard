# ── ASR Dashboard Frontend — Environment Variables ─────────────────────────
# Copy this file to .env (local) or set in Netlify Dashboard → Site Settings
# → Environment Variables

# URL of the deployed FastAPI backend on Render.
# Leave empty for local dev (Vite proxy handles /api automatically).
# Example: https://asr-dashboard-api.onrender.com
VITE_API_URL=
