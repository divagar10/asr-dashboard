# ── ASR Dashboard Backend — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# Render.com: set these in Dashboard → Environment → Add Environment Variable

# Comma-separated list of allowed frontend origins.
# Add your Netlify URL here after deploying, e.g.:
#   ALLOWED_ORIGINS=https://asr-dashboard.netlify.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Port — Render sets this automatically. Leave as-is for local dev.
PORT=8000
